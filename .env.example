# Copy this file to .env and fill in real values. Never commit .env.
# All Expo env vars exposed to client code must be prefixed EXPO_PUBLIC_.

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Base URL of the backend API (see api/apiClient.ts). Use your machine's LAN
# IP (not localhost) when testing on a physical device or simulator.
EXPO_PUBLIC_API_URL=http://192.168.0.106:3000/api
